# Telegram Bot API token — получить у @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Telegram id владельца бота (узнать у @userinfobot). Обязателен: владелец проходит
# знакомство без приглашения и может создавать приглашения командой /invite.
OWNER_ID=

# Необязательно: ИИ-оценка калорий по описанию («гречка с курицей» → ккал) через Gemini API.
# Ключ — aistudio.google.com → Get API key. Без ключа еда пишется только с числом («обед 650»).
GEMINI_API_KEY=
# Необязательно: конкретная модель; по умолчанию gemini-flash-latest с запасными вариантами.
GEMINI_MODEL=

# URL Telegram Mini App (деплой на Vercel). Если задан — бот включает menu-кнопку
# «Дневник» и команду /app. Оставь пустым, если Mini App ещё не задеплоен.
WEBAPP_URL=

# Нужен только для архивного способа деплоя на Yandex Cloud Functions (см. README) — для Render не используется.
WEBHOOK_SECRET=
